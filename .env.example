# Copy to .env to override the local defaults. .env is git-ignored.
# Used by docker-compose.yml and by the backend (application.yml).
DB_NAME=acme_salary
DB_USERNAME=acme
DB_PASSWORD=acme
DB_PORT=5433
# Full JDBC URL for the backend; when unset it is built from DB_PORT and DB_NAME.
# DB_URL=jdbc:postgresql://localhost:5433/acme_salary

# Optional shared login (HTTP basic auth). Leave both unset to run without a login locally.
# The hosted instance (SPRING_PROFILES_ACTIVE=prod) refuses to start without them.
# The values below are for trying it on your own machine only; never reuse them anywhere real.
# APP_SECURITY_USERNAME=hr
# APP_SECURITY_PASSWORD=local-only-change-me
