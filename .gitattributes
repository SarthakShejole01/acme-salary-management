# Normalise line endings so the repo behaves the same on Windows, CI (Linux) and Docker.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must stay LF (gradlew breaks in Docker/CI otherwise)
gradlew text eol=lf
*.sh    text eol=lf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
